# 统一换行符，避免 Windows 提交后别人在 Linux/macOS 克隆时出问题
* text=auto eol=lf

# Windows 批处理必须是 CRLF
*.bat text eol=crlf

# shell 脚本必须是 LF，否则报 "bad interpreter"
gradlew text eol=lf

# 二进制文件不要做换行转换
*.jar binary
*.apk binary
*.aab binary
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.ttf binary
*.so binary
*.mp3 binary

# 音频是生成物，但必须提交（否则克隆下来没有发音），
# 标记为生成代码以免污染语言统计
app/src/main/assets/audio/** linguist-generated=true

# 锁文件在 diff 里没意义，但保留可读性
package-lock.json linguist-generated=true
